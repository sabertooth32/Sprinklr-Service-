{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Sprinklr Service Account Radar dossier",
 "type": "object",
 "required": [
  "meta",
  "snapshot",
  "icp",
  "why_now",
  "entry_points",
  "buying_centres",
  "contacts",
  "channels",
  "incumbents",
  "journey",
  "maturity",
  "gap_map",
  "business_case",
  "outreach",
  "mystery_shop",
  "discovery_questions",
  "objections",
  "do_not_say",
  "prospect_view",
  "evidence"
 ],
 "properties": {
  "meta": {
   "type": "object",
   "required": [
    "account",
    "slug",
    "run_date",
    "region",
    "validation"
   ],
   "properties": {
    "account": {
     "type": "string"
    },
    "slug": {
     "type": "string"
    },
    "run_date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "region": {
     "type": "string"
    },
    "focus": {
     "type": "string"
    },
    "validation": {
     "type": "object",
     "required": [
      "facts_checked",
      "confirmed",
      "corrected",
      "dropped",
      "people_checked",
      "people_removed",
      "gates"
     ],
     "properties": {
      "facts_checked": {
       "type": "integer"
      },
      "confirmed": {
       "type": "integer"
      },
      "corrected": {
       "type": "integer"
      },
      "dropped": {
       "type": "integer"
      },
      "people_checked": {
       "type": "integer"
      },
      "people_removed": {
       "type": "integer"
      },
      "gates": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "gate",
         "by",
         "status"
        ],
        "properties": {
         "gate": {
          "type": "string"
         },
         "by": {
          "type": "string"
         },
         "status": {
          "enum": [
           "pass",
           "pass_with_notes",
           "fail",
           "pending"
          ]
         },
         "note": {
          "type": "string"
         }
        }
       }
      }
     }
    }
   }
  },
  "snapshot": {
   "type": "object",
   "required": [
    "one_liner",
    "industry",
    "hq",
    "facts",
    "strategic_priorities",
    "sprinklr_relationship",
    "why_now_headline"
   ],
   "properties": {
    "one_liner": {
     "type": "string"
    },
    "industry": {
     "type": "string"
    },
    "hq": {
     "type": "string"
    },
    "facts": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "label",
       "value",
       "basis"
      ],
      "properties": {
       "label": {
        "type": "string"
       },
       "value": {
        "type": "string"
       },
       "basis": {
        "enum": [
         "disclosed",
         "third_party",
         "estimate"
        ]
       },
       "evidence": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "Evidence ids from the evidence array"
       }
      }
     },
     "minItems": 4,
     "maxItems": 6
    },
    "strategic_priorities": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "priority",
       "so_what"
      ],
      "properties": {
       "priority": {
        "type": "string"
       },
       "so_what": {
        "type": "string"
       },
       "evidence": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "Evidence ids from the evidence array"
       }
      }
     },
     "minItems": 2,
     "maxItems": 4
    },
    "sprinklr_relationship": {
     "type": "object",
     "required": [
      "status"
     ],
     "properties": {
      "status": {
       "enum": [
        "known customer",
        "none found",
        "unclear"
       ]
      },
      "note": {
       "type": "string"
      }
     }
    },
    "why_now_headline": {
     "type": "string"
    }
   }
  },
  "icp": {
   "type": "object",
   "required": [
    "total",
    "tier",
    "verdict",
    "scorecard",
    "hard_stops"
   ],
   "properties": {
    "total": {
     "type": "number"
    },
    "tier": {
     "enum": [
      "A",
      "B",
      "C"
     ]
    },
    "verdict": {
     "type": "string"
    },
    "scorecard": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "line",
       "max",
       "points",
       "reason"
      ],
      "properties": {
       "line": {
        "type": "string"
       },
       "max": {
        "type": "number"
       },
       "points": {
        "type": "number"
       },
       "reason": {
        "type": "string"
       }
      }
     },
     "minItems": 9,
     "maxItems": 9
    },
    "hard_stops": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "stop",
       "triggered"
      ],
      "properties": {

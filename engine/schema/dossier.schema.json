        "type": "string"
       },
       "triggered": {
        "type": "boolean"
       },
       "note": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "why_now": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "date",
     "type",

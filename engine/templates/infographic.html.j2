{% import '_macros.j2' as m %}
{% set acct = d.meta.account %}
{% set fl = 'An outside-in view prepared by ' ~ theme.brand_name ~ ' for ' ~ acct ~ ' · ' ~ d.meta.run_date ~ ' · Built from public sources. To be tested with your data.' %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ pv.title }}</title>
<meta name="viewport" content="width=1280">
<style>{{ css | safe }}
.hero { font-size: 31px; }
.track { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
.obs { border-radius: 10px; padding: 11px 12px; background: var(--brand-tint); border-top: 4px solid var(--brand); font-size: 11.6px; line-height: 1.42; }
.obs h3 { font-size: 13px; margin-bottom: 4px; line-height: 1.2; }
.obs .ph { font-size: 8.5px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--brand-dark); margin-bottom: 3px; display: flex; align-items: center; gap: 4px; }
.obs .ph svg { width: 10px; height: 10px; fill: #d99400; }
.smooth { border-radius: 10px; padding: 11px 12px; background: var(--soft); font-size: 10.8px; color: var(--muted); border-top: 4px solid #d5d9e0; line-height: 1.4; }
.opp { border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; display: flex; flex-direction: column; gap: 7px; }
.opp .n { width: 30px; height: 30px; border-radius: 50%; background: var(--brand); color: #fff; font-weight: 800; font-size: 14px; display: flex; align-items: center; justify-content: center; }
.opp h3 { font-size: 15px; line-height: 1.2; letter-spacing: -.01em; }
.how { margin-top: auto; background: var(--brand-tint); border-radius: 8px; padding: 8px 10px; font-size: 10.3px; }
.src { font-size: 8.6px; color: var(--muted); line-height: 1.45; columns: 2; column-gap: 22px; }
.src span { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
</head>
<body>

{# ============ PAGE 1: THE JOURNEY ============ #}
<section class="page" data-title="Journey">
  <div class="head">
    <div>
      <div class="kicker">Customer service · an outside-in view</div>
      <h1 class="hero">{{ pv.title }}</h1>
      <div class="sub">{{ pv.subtitle }}</div>
    </div>
    <div class="tagright">{{ m.wordmark(theme, logo) }}</div>
  </div>
  <div class="body col" style="gap:12px">
    <div class="row" style="flex:none;align-items:stretch">
      <div class="card soft grow" style="padding:10px 14px">
        <div class="label">How to read this</div>
        <div class="small" style="margin-top:3px">{{ pv.framing }}</div>
      </div>
      <div class="card" style="padding:10px 14px;width:520px;flex:none;background:var(--good-bg);border-color:transparent">
        <div class="label" style="color:var(--good-ink)">What already works well</div>
        <ul class="tight small" style="margin-top:3px">{% for s in pv.strengths %}<li>{{ s.text }}</li>{% endfor %}</ul>
      </div>
    </div>

    <div style="flex:1;min-height:0;display:flex;flex-direction:column">
      <div class="journey" style="flex:none">
        {% for st in stages %}
        <div class="stage"><div class="chev"><span class="n">STAGE {{ st.n }}</span><span class="t">{{ st.name }}</span></div></div>
        {% endfor %}
      </div>
      <div class="track" style="margin-top:8px;flex:1;min-height:0;align-items:start">
        {% for st in stages %}
        <div>
          {% for o in obs_by_stage.get(st.n, []) %}
          <div class="obs" style="margin-bottom:6px"><div class="ph">A question worth testing</div><h3>{{ o.title }}</h3>{{ o.text }}</div>
          {% else %}
          <div class="smooth">Not covered in this first view.</div>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
    </div>

    <div class="row" style="flex:none;align-items:stretch;gap:18px">
      {% for key, title, idx, lvl, levels, on, seen_n, total_n, ok in [
        ('exp', 'Experience maturity', exp_index, exp_level, EXP_LEVELS, exp_level[0] - 1, coverage.exp_seen, coverage.exp_total, coverage.exp_ok),
        ('ai', 'AI in service maturity', ai_index, ai_level, AI_LEVELS, ai_level[0], coverage.ai_seen, coverage.ai_total, coverage.ai_ok)] %}
      <div class="card" style="flex:1;padding:10px 14px">
        {% if ok %}
        {{ m.gauge(idx, title ~ ' · outside-in estimate', 'Level ' ~ lvl[0] ~ ' of 5 · ' ~ lvl[1], 96) }}
        {{ m.ladder(levels, on) }}
        <div class="tiny muted" style="margin-top:5px">Based on {{ seen_n }} of {{ total_n }} signals visible from outside.</div>
        {% else %}
        <div class="label">{{ title }} · the scale we use</div>
        {{ m.ladder(levels, -1) }}
        <div class="small ink2" style="margin-top:7px">We have not placed you on this scale. Most of what decides it is not public, and we would rather ask than guess.</div>
        {% endif %}
      </div>
      {% endfor %}
      <div style="width:250px;flex:none;align-self:center" class="tiny muted">We look at each public support channel on five experience and five AI dimensions. Most of how service runs is not visible from outside. Your own data will sharpen this view.</div>
    </div>
  </div>
  {{ m.foot(fl, 'Page') }}
</section>

{# ============ PAGE 2: WHAT GOOD LOOKS LIKE ============ #}
<section class="page" data-title="Opportunities">
  <div class="head">
    <div>
      <div class="kicker">From observation to opportunity</div>
      <h1 class="hero">{{ pv.opportunities_title or 'Three ideas to test together' }}</h1>
      <div class="sub">{{ pv.opportunities_subtitle or 'Each one builds on what you already have.' }}</div>
    </div>
    <div class="tagright">{{ m.wordmark(theme, logo) }}</div>
  </div>
  <div class="body col" style="gap:12px">
    <div class="grid g3" style="flex:1 0 auto;gap:14px">
      {% for o in pv.opportunities %}
      <div class="opp">
        <div class="n">{{ loop.index }}</div>
        <h3>{{ o.title }}</h3>
        <div class="label">What good looks like</div>
        <div style="font-size:11.5px;line-height:1.45">{{ o.what_good_looks_like }}</div>
        <div class="how"><span class="label" style="color:var(--brand-dark)">How {{ theme.product_name }} helps</span>
          {% for c in o.caps[:1] %}<div style="margin-top:3px"><b>{{ c.name }}.</b> {{ c.what_it_does }}</div>{% endfor %}
          {% if o.caps | length > 1 %}<div style="margin-top:3px" class="ink2">Also: {{ o.caps[1:3] | map(attribute='name') | join(', ') }}.</div>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="row" style="flex:none;align-items:stretch">
      {% if pv.show_value_band %}
      <div class="card tint" style="width:330px;flex:none;display:flex;flex-direction:column;justify-content:center">
        <div class="label">Value at stake · illustrative</div>
        <div class="num" style="margin:6px 0 5px;font-size:30px;white-space:nowrap">{{ value.low.total }} – {{ value.base.total }}</div>
        <div class="tiny ink2">Per year, across five levers. Built on public estimates of your contact volume and independent cost benchmarks. Conservative by design. We would like to test it with your numbers.</div>
      </div>
      {% endif %}
      <div class="card grow">
        <div class="label">The measures that move</div>
        <table style="margin-top:4px;font-size:10.4px">
          <tr><th>Measure</th><th>Direction</th><th>How</th></tr>
          {% for k in d.business_case.kpis[:4] %}<tr><td class="b" style="padding:4px 8px 4px 0">{{ k.kpi }}</td><td style="padding:4px 8px 4px 0">{{ k.target }}</td><td class="ink2" style="padding:4px 0">{{ k.lever }}</td></tr>{% endfor %}
        </table>
      </div>
      <div class="card brand" style="width:300px;flex:none;display:flex;flex-direction:column;justify-content:center">
        <div class="label">Next step</div>
        <div style="font-size:16px;font-weight:700;line-height:1.3;margin-top:4px">{{ pv.cta }}</div>
      </div>
    </div>

    <div style="flex:none">
      <div class="label" style="margin-bottom:3px">Sources · public information only</div>
      <div class="src">{% for s in pv_sources[:12] %}<span>{{ loop.index }}. <a href="{{ s.source_url }}">{{ s.source_title or s.claim }}</a> · {{ s.source_date }}</span>{% endfor %}</div>
    </div>
  </div>
  {{ m.foot(fl, 'Page') }}
</section>
</body>
</html>
